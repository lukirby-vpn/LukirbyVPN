          "type": "leastLoad",
          "settings": {
            "costs": [
              {
                "match": "main-proxy-",
                "regexp": true,
                "value": 0
              },
              {
                "match": "wl-proxy-",
                "regexp": true,
                "value": 20000
              }
            ]
          }
        }
      },
      {
